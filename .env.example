# ─────────────────────────────────────────────────────────────────────
#  Digital Business Card — Next.js Environment Variables
#  Copy this file to .env.local and fill in your Supabase credentials.
#
#  Find values at: https://supabase.com/dashboard/project/_/settings/api
# ─────────────────────────────────────────────────────────────────────

# Supabase Project URL (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous / Public key (required — safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
